# ============================================
# ENVIRONMENT CONFIGURATION - VANSHA PLATFORM
# ============================================
# Copy to .env.local for development
# Use .env.production for production secrets

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# WEB APPLICATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vansha

# ============================================
# AUTHENTICATION (CLERK)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# API SERVER
# ============================================
API_PORT=3001
API_HOST=0.0.0.0

# ============================================
# POSTGRESQL
# ============================================
DATABASE_URL=postgresql://vansha:vansha_password@localhost:5432/vansha_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vansha
DATABASE_PASSWORD=vansha_password
DATABASE_NAME=vansha_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ============================================
# NEO4J (GRAPH DATABASE)
# ============================================
NEO4J_URI=neo4j://localhost:7687
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# MEILISEARCH
# ============================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=test_key_dev_only

# ============================================
# CLOUDFLARE R2 (FILE STORAGE)
# ============================================
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_BUCKET_NAME=vansha-prod
CLOUDFLARE_PUBLIC_URL=https://vansha.your-cdn.com

# ============================================
# OPENAI (OCR & AI SERVICES)
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4-vision
OPENAI_ORG_ID=

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars
REFRESH_TOKEN_EXPIRATION=30d
BCRYPT_ROUNDS=12
CSRF_TOKEN_SECRET=your_csrf_token_secret

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# FEATURES
# ============================================
ENABLE_OCR_IMPORT=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SOCIAL_FEATURES=false

# ============================================
# PRIVACY
# ============================================
DEFAULT_GENERATION_DEPTH=3
MAX_SEARCH_RESULTS=100
ENABLE_FUZZY_SEARCH=true

# ============================================
# SENTRY (ERROR TRACKING)
# ============================================
SENTRY_DSN=

# ============================================
# EMAIL SERVICE
# ============================================
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=

# ============================================
# ANALYTICS
# ============================================
ENABLE_ANALYTICS=false
ANALYTICS_ID=

# ============================================
# DEPLOYMENT
# ============================================
VERCEL_URL=
RAILWAY_URL=
