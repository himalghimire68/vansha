{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "baseUrl": "./",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@app/*": ["src/*"],
      "@common/*": ["src/common/*"],
      "@vansha/graph-engine": ["../../packages/graph-engine/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
