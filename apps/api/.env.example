# Node
NODE_ENV=production
API_PORT=3001

# Database (Railway PostgreSQL — copy from Railway service variables)
DATABASE_TYPE=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=true

# JWT
JWT_SECRET=
JWT_EXPIRATION=7d

# CORS — set to your Vercel frontend URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
